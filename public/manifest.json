{
  "name": "Rubik OS",
  "short_name": "Rubik",
  "description": "Hub Administrativo Rubik Bolivia",
  "start_url": "/login.html",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/icono app.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icono app.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icono app.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icono app.png",
      "sizes": "549x549",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/compartir/recibir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "archivos",
          "accept": [
            ".fbx",
            ".glb",
            ".gltf",
            ".zip",
            ".pdf",
            "model/gltf-binary",
            "model/gltf+json",
            "application/zip",
            "application/x-zip-compressed",
            "application/pdf",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}
