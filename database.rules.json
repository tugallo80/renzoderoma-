{
  "rules": {

    // ══════════════════════════════════════════════════════════════
    //  RUBIK OS — Firebase Realtime Database Security Rules
    //  Principio: denegación por defecto. Solo se permite lo explícito.
    //
    //  Acceso "hub": solo los uid listados en /acceso/hub/{uid} = true.
    //  Esa lista se edita únicamente desde la consola de Firebase
    //  (las reglas no permiten escribirla desde la app).
    //
    //  Las apps de clientes, trabajadores, contratistas, supervisores y
    //  agencia (login anónimo) quedan SIN acceso a datos hasta la salida
    //  a la venta. Ver docs/plan-sesiones.md (Sesión 0, Prioridad 2).
    // ══════════════════════════════════════════════════════════════

    // ─── LISTA BLANCA ─────────────────────────────────────────────
    // Cada usuario hub puede leer solo su propia entrada. Nadie escribe.
    "acceso": {
      "hub": {
        "$uid": {
          ".read":  "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },

    // ─── PORTAFOLIO PÚBLICO ────────────────────────────────────────
    // La landing page pública lee los proyectos sin autenticación.
    // Solo hub puede escribir.
    "portafolio": {
      ".read":  true,
      ".write": "auth != null && root.child('acceso').child('hub').child(auth.uid).val() === true"
    },

    // ─── AGENTE IA (docs/sesiones/04-agente-ia.md) ──────────────────
    // La cola de turnos la escribe y la lee solo la Function (admin).
    // Los costos los escribe solo la Function; el hub los lee.
    "agente_cola": {
      ".read":  false,
      ".write": false
    },
    "agente_costos": {
      ".read":  "auth != null && root.child('acceso').child('hub').child(auth.uid).val() === true",
      ".write": false
    },

    // ─── CONECTOR MCP "Rubik" (docs/sesiones/05-rubik-agente-app.md) ─
    // Clientes OAuth, códigos y tokens (solo hashes): solo la Function.
    // Respaldos que deja el conector antes de cambiar algo: el hub los lee, nadie escribe desde la app.
    "mcp_oauth": {
      ".read":  false,
      ".write": false
    },
    "respaldos_agente": {
      ".read":  "auth != null && root.child('acceso').child('hub').child(auth.uid).val() === true",
      ".write": false
    },

    // ─── RENDER (sesión 6): la cola de pedidos la escribe el conector y la lee renderTurno (admin).
    "render_cola": {
      ".read":  false,
      ".write": false
    },

    // ─── REQUERIMIENTOS (docs/sesiones/06-render-requerimiento.md) ──
    // Lo que pidió el cliente: el hub lo lee; lo escribe solo la Function /api/requerimiento
    // (valida la entrada) y el conector MCP. Archivos en Storage requerimientos/…, solo servidor.
    "requerimientos": {
      ".read":  "auth != null && root.child('acceso').child('hub').child(auth.uid).val() === true",
      ".write": false,
      ".indexOn": ["estado", "actualizado"]
    },

    // ─── TODO LO DEMÁS: SOLO HUB ──────────────────────────────────
    // proyectos (pagos, compras, licitaciones), clientes, personal,
    // supervisores, caja_chica, ingresos, cobros, base_datos, config_ia,
    // notificaciones, whatsapp_*, gantt, etc.
    "$other": {
      ".read":  "auth != null && root.child('acceso').child('hub').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('acceso').child('hub').child(auth.uid).val() === true"
    }
  }
}
